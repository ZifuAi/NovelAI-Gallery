{
  "manifest_version": 3,
  "name": "NovelAI Gallery Sync",
  "version": "1.6.0",
  "description": "Automatically saves NovelAI-generated images (with their embedded prompt metadata) to your local NovelAI Gallery app.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "scripting",
    "contextMenus",
    "alarms",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "https://novelai.net/*",
    "https://*.novelai.net/*",
    "https://*.novelai.workers.dev/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://novelai.net/*",
        "https://*.novelai.net/*",
        "https://*.novelai.workers.dev/*"
      ],
      "js": [
        "inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://novelai.net/*",
        "https://*.novelai.net/*",
        "https://*.novelai.workers.dev/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
